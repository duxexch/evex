# ========================================
# VEX Platform - Environment Variables Template
# ملف قالب متغيرات البيئة لمنصة VEX
# ========================================
# Copy this file to .env and fill in your values
# انسخ هذا الملف إلى .env واملأ القيم الخاصة بك

# ========================================
# ⚠️ IMPORTANT: CHOOSE YOUR ENVIRONMENT
# ⚠️ مهم: اختر بيئتك
# ========================================
# OPTION 1: VPS/Server (Hostinger, DigitalOcean, etc.)
#   - Use PGHOST=localhost
#   - Use ?sslmode=disable for local PostgreSQL
#
# OPTION 2: Docker
#   - Use PGHOST=db (Docker service name)
#   - SSL settings depend on your setup

# ========================================
# DATABASE CONFIGURATION (Required)
# إعدادات قاعدة البيانات (مطلوب)
# ========================================

# --- FOR VPS/SERVER (Recommended) ---
# للسيرفر / VPS (موصى به)
# NOTE: Change port if another PostgreSQL is running (e.g., 5433)
POSTGRES_USER=vex_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=vex_db
PGHOST=localhost
PGPORT=5433
DATABASE_URL=postgresql://vex_user:your_secure_password_here@localhost:5433/vex_db?sslmode=disable

# --- FOR DOCKER (Uncomment if using Docker) ---
# لـ Docker (أزل التعليق إذا كنت تستخدم Docker)
# NOTE: Docker uses internal port 5432 (container-to-container)
# VPS uses 5433 to avoid conflicts with other services
# PGHOST=db
# DATABASE_URL=postgresql://vex_user:your_secure_password_here@db:5432/vex_db

# ========================================
# APPLICATION SETTINGS (Required)
# إعدادات التطبيق (مطلوب)
# ========================================
NODE_ENV=production
# NOTE: Changed from 5000 to 5050 to avoid conflicts with other services
PORT=5050

# Generate with: openssl rand -base64 32
# ⚠️ REQUIRED in production - app will fail without these!
SESSION_SECRET=your_32_character_secret_key_here
JWT_SECRET=your_jwt_secret_key_here

# Trust proxy for rate limiting behind Nginx
TRUST_PROXY=true

# Application URL (your domain)
APP_URL=https://vixo.click

# ========================================
# ADMIN USER (Auto-created on first run)
# مستخدم الأدمن (يُنشأ تلقائياً)
# ========================================
# Admin credentials - SET YOUR OWN VALUES!
# بيانات الأدمن - حدد قيمك الخاصة!
# IMPORTANT: Do NOT use defaults in production - set strong credentials
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# ========================================
# SMS/OTP - Twilio (Optional)
# الرسائل القصيرة - Twilio (اختياري)
# ========================================
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# ========================================
# EMAIL - SendGrid (Optional)
# البريد الإلكتروني - SendGrid (اختياري)
# ========================================
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ========================================
# GOOGLE OAuth (Optional)
# تسجيل دخول Google (اختياري)
# ========================================
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret

# ========================================
# FACEBOOK OAuth (Optional)
# تسجيل دخول Facebook (اختياري)
# ========================================
# FACEBOOK_APP_ID=your_app_id
# FACEBOOK_APP_SECRET=your_app_secret

# ========================================
# TELEGRAM Bot (Optional)
# بوت Telegram (اختياري)
# ========================================
# TELEGRAM_BOT_TOKEN=your_bot_token

# ========================================
# PAYMENTS - Stripe (Optional)
# الدفع - Stripe (اختياري)
# ========================================
# STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxx
# STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ========================================
# PUSH NOTIFICATIONS - Firebase (Optional)
# الإشعارات الفورية - Firebase (اختياري)
# ========================================
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# ========================================
# RATE LIMITING (Optional - has defaults)
# تحديد معدل الطلبات (اختياري - له قيم افتراضية)
# ========================================
# RATE_LIMIT_WINDOW=60000
# RATE_LIMIT_MAX=100
