# VEX Platform Environment Configuration
# تكوين بيئة منصة VEX

# Database Connection / اتصال قاعدة البيانات
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://vex_user:your_password_here@localhost:5432/vex_db

# Session Secret / مفتاح الجلسة السري
# Generate a random string (use: openssl rand -base64 32)
SESSION_SECRET=your_random_secret_key_here_minimum_32_characters

# Server Port / منفذ الخادم
PORT=5000

# Node Environment / بيئة Node
NODE_ENV=production
