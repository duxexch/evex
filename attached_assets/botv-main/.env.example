# .env.example - LangSense PWM (Platform Web Management)
# ✅ Web-based control panel configuration
# ⚠️ NEVER commit actual secrets to version control

# ============================================================================
# WEB ADMIN CONFIGURATION
# ============================================================================
ADMIN_EMAIL=admin@langsense.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_strong_password
ADMIN_USER_IDS=1

# BOT_TOKEN (optional - kept for backward compatibility)
BOT_TOKEN=dummy-token-for-pwm-mode

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_USER=langsense
DB_PASSWORD=langsense_secure_pw
DB_NAME=langsense
DB_PORT=5432

# Development (SQLite)
# DATABASE_URL=sqlite+aiosqlite:///./langsense.db

# Production (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://langsense:langsense_secure_pw@localhost:5432/langsense

# ============================================================================
# REDIS CACHE
# ============================================================================
REDIS_PASSWORD=redis_secure_pw
REDIS_PORT=6379
REDIS_URL=redis://:redis_secure_pw@localhost:6379/0

# ============================================================================
# API & SERVER
# ============================================================================
PORT=8000
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# ============================================================================
# SECURITY (⚠️ CHANGE IN PRODUCTION!)
# ============================================================================
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-this-in-production-with-strong-random-key
ENCRYPTION_KEY=change-this-in-production-with-strong-random-key

# ============================================================================
# BOT CONFIGURATION
# ============================================================================
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_USER_IDS=123456789,987654321

# ============================================================================
# CORS & ALLOWED ORIGINS
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Production: Set specific domains instead of localhost
# CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# ============================================================================
# LOCALIZATION
# ============================================================================
DEFAULT_LANGUAGE=ar
DEFAULT_COUNTRY=SA

# ============================================================================
# FINANCIAL LIMITS
# ============================================================================
MIN_DEPOSIT=50
MAX_DEPOSIT=100000
MIN_WITHDRAWAL=100
MAX_DAILY_WITHDRAWAL=10000

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_FILE=langsense.log
LOG_LEVEL=INFO

# ============================================================================
# RATE LIMITING
# ============================================================================
USER_RATE_LIMIT=5
ADMIN_RATE_LIMIT=30
API_RATE_LIMIT=100
DEPOSIT_RATE_LIMIT=10
WITHDRAWAL_RATE_LIMIT=10
