# .env.production - Production Environment Template
# ⚠️ SECURITY CRITICAL: Never commit this file with real values!

# ==================== BOT CONFIGURATION ====================
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
ADMIN_USER_IDS=123456789,987654321

# ==================== DATABASE ====================
# Production PostgreSQL with connection pooling
DATABASE_URL=postgresql+asyncpg://langsense:YOUR_DB_PASSWORD_HERE@localhost:5432/langsense
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=100
DB_POOL_RECYCLE=3600

# ==================== SECURITY ⚠️ CRITICAL ====================
# Generate: python -c "import os; print(os.urandom(32).hex())"
ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY_32_BYTES_HEX

# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY_HERE
JWT_EXPIRATION_HOURS=24

# ==================== CORS - API ORIGINS ====================
# Restrict to your actual domains in production
CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com,https://app.yourdomain.com

# ==================== HTTPS ====================
FORCE_HTTPS=true
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,www.yourdomain.com

# ==================== BROADCAST ====================
BROADCAST_RATE_LIMIT=20
BROADCAST_CHUNK_SIZE=100
BROADCAST_RETRY_ATTEMPTS=3
BROADCAST_RETRY_DELAY=5

# ==================== LOCALIZATION ====================
DEFAULT_LANGUAGE=ar
DEFAULT_COUNTRY=SA

# ==================== CUSTOMER ID ====================
CUSTOMER_ID_PREFIX=C
CUSTOMER_ID_YEAR_FORMAT=2025

# ==================== FILE UPLOAD ====================
MAX_FILE_SIZE=20

# ==================== PAGINATION ====================
USERS_PER_PAGE=10
ANNOUNCEMENTS_PER_PAGE=5
TRANSACTIONS_PER_PAGE=20

# ==================== LOGGING ====================
LOG_LEVEL=WARNING
LOG_FILE=/var/log/langsense/bot.log

# ==================== RATE LIMITING ====================
USER_RATE_LIMIT=10
ADMIN_RATE_LIMIT=50
API_RATE_LIMIT=200
DEPOSIT_RATE_LIMIT=5
WITHDRAWAL_RATE_LIMIT=5

# ==================== FINANCIAL LIMITS ====================
MIN_DEPOSIT=50
MAX_DEPOSIT=100000
MIN_WITHDRAWAL=100
MAX_DAILY_WITHDRAWAL=10000

# ==================== REDIS ====================
# Use secure password from setup_vps.sh
REDIS_URL=redis://:YOUR_REDIS_PASSWORD_HERE@localhost:6379/0

# ==================== RABBITMQ (Optional) ====================
# RABBITMQ_URL=amqp://user:password@localhost:5672/

# ==================== ENVIRONMENT ====================
ENVIRONMENT=production

# ==================== MONITORING (Optional) ====================
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# PROMETHEUS_PORT=9090

# ==================== EMAIL (Optional) ====================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@yourdomain.com
