# ============================================================================
# PWM Environment Variables - Template (.env.pwm.example)
# Copy to .env.pwm and update values
# ============================================================================

# ============================================================================
# API Configuration
# ============================================================================
PWM_API_PORT=8011
PWM_ENV=development
PWM_API_TITLE=PWM API
PWM_API_VERSION=1.0.0

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL async connection string
PWM_DATABASE_URL=postgresql+asyncpg://pwm_user:pwm_password@localhost:5432/pwm_db

# For Alembic migrations (sync version)
PWM_DATABASE_URL_SYNC=postgresql://pwm_user:pwm_password@localhost:5432/pwm_db

# Database credentials for Docker
PWM_DB_USER=pwm_user
PWM_DB_PASSWORD=pwm_secure_pw_2026

# ============================================================================
# JWT Configuration
# ============================================================================
# ⚠️ IMPORTANT: Change this in production!
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-key-change-in-production-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================================================
# CORS Configuration
# ============================================================================
PWM_CORS_ORIGINS=["http://localhost:3012", "http://localhost:3001", "http://localhost", "http://pwm-web:3012"]

# ============================================================================
# API Configuration
# ============================================================================
PWM_API_BASE_URL=http://localhost:8011
PWM_LOG_LEVEL=INFO

# ============================================================================
# Frontend Configuration
# ============================================================================
NEXT_PUBLIC_PWM_API_BASE=http://localhost:8011/pwm/api
NODE_ENV=development

# ============================================================================
# Docker Compose Configuration (optional)
# ============================================================================
# DB_USER=langsense
# DB_PASSWORD=langsense_secure_pw_2026
# DB_NAME=langsense
# REDIS_PASSWORD=redis_secure_pw_2026
